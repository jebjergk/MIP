# mip_ui_api reads the REPO ROOT `.env` (mip_0.7/.env) — see `app/config.py` (load_dotenv).
# Add this line there and restart the API:
#
# TAPE_OBSERVER_BASE_URL=http://127.0.0.1:8095
#
# Phase 2 optional live politician disclosure (requires COMMITTEE2_LIVE_POLITICIAN_DISCLOSURE_ENABLED in Snowflake):
# Capitol Trades — link-out only (no env below), or POC HTML scrape (server-side fetch):
# MIP_POLITICIAN_DISCLOSURE_LIVE_URL_TEMPLATE=https://www.capitoltrades.com/trades?ticker={symbol}
# MIP_POLITICIAN_DISCLOSURE_POC_SCRAPE=true
# — or internal JSON bridge:
# MIP_POLITICIAN_DISCLOSURE_LIVE_URL_TEMPLATE=https://your-host.example/disclosures/{symbol}
# — or local stub only (no template):
# MIP_POLITICIAN_DISCLOSURE_LIVE_DEMO=true
