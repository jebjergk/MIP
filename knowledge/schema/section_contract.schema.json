{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mip.local/knowledge/section_contract.schema.json",
  "title": "SectionContract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_id",
    "version",
    "status",
    "owner",
    "last_updated",
    "section_id",
    "page_id",
    "purpose"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "active", "deprecated"] },
    "owner": { "type": "string" },
    "last_updated": { "type": "string" },
    "section_id": { "type": "string" },
    "page_id": { "type": "string" },
    "section_title": { "type": "string" },
    "purpose": { "type": "string" },
    "widget_ids": { "type": "array", "items": { "type": "string" } },
    "user_questions_answered": { "type": "array", "items": { "type": "string" } },
    "interpretation_guidance": { "type": "string" },
    "linked_logic_concepts": { "type": "array", "items": { "type": "string" } },
    "related_workflows": { "type": "array", "items": { "type": "string" } }
  }
}
